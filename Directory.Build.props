<Project>

  <!--
	Shared build + packaging metadata for the SaveHub solution.

	The backend "API" libraries (Core, Hosting, GitHub, GitLab, Bitbucket, Supabase, GoogleDrive)
	are packed into the local NuGet feed at ./local-feed so that frontends
	(WinForms, or any third-party UI) can consume them as NuGet packages
	instead of ProjectReferences.

	Application projects (WinForms, CLI) opt out of packing by setting
	<IsPackable>false</IsPackable> in their own .csproj.
  -->

  <PropertyGroup>
	<!-- Package version used for every packable library. Bump this whenever
		 you re-pack after changing library code (see pack-api.ps1). -->
	<Version>1.0.0</Version>

	<Authors>SaveHub</Authors>
	<Company>SaveHub</Company>
	<Product>SaveHub</Product>
	<Description>SaveHub — back up emulator and game saves (memory cards, save states, and save folders) to cloud storage you control. Part of the SaveHub API.</Description>
	<PackageTags>savehub;game-saves;emulator;memory-card;save-state;backup</PackageTags>
	<PackageProjectUrl>https://github.com/uncle-uee/SaveHub</PackageProjectUrl>
	<RepositoryUrl>https://github.com/uncle-uee/SaveHub</RepositoryUrl>
	<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>

	<!-- All packages are dropped into the repo-local feed. -->
	<PackageOutputPath>$(MSBuildThisFileDirectory)local-feed</PackageOutputPath>
  </PropertyGroup>

</Project>
